replicaCount: 1

image:

  repository: devnitoracr001.azurecr.io/backendimage

  tag: "v1.0.1"

  pullPolicy: IfNotPresent


containerPort: 8080


service:

  type: ClusterIP

  port: 80

  targetPort: 8080


frontendOrigin: ""


ingress:

  enabled: false

  className: nginx

  host: ""

  path: /api


migration:

  enabled: true